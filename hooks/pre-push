#!/usr/bin/env bash
# Versioned pre-push hook — full gate (security whole-repo + FULL test suite).
# Pre-commit stays fast (changed packages only); push proves everything.
set -e
echo "=== pre-push: full security gate ==="
export LINT_BASE="${LINT_BASE:-origin/master}"
./scripts/security-check.sh
echo "=== pre-push: gate passed ==="
echo "=== pre-push: full test suite (single pass, shuffled, 25m cap) ==="
go test -timeout 25m -shuffle=on -count=1 ./...
echo "=== pre-push: all green ==="
