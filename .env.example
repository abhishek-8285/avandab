# Environment configuration
# Copy to .env and adjust values

# Database URL
# SQLite local: file:mvtms.db?cache=shared&mode=rwc
# Turso: libsql://your-database.turso.io?api-token=your-token
DATABASE_URL=file:mvtms.db?cache=shared&mode=rwc&_pragma=journal_mode(WAL)

# ── Database Engine Selection (env-only switch, no code changes) ──────
# Driver: sqlite (default) | postgres | mysql
# DATABASE_DRIVER=sqlite
#
# Postgres example:
#   DATABASE_DRIVER=postgres
#   DATABASE_URL=postgres://user:pass@localhost:5432/mvtms?sslmode=disable
# MySQL example:
#   DATABASE_DRIVER=mysql
#   DATABASE_URL=user:pass@tcp(localhost:3306)/mvtms?parseTime=true
#
# Connection pool sizing (optional):
# DB_MAX_OPEN_CONNS=
# DB_MAX_IDLE_CONNS=
# DB_CONN_MAX_LIFETIME=15m

# ── Cache Backend Selection (env-only switch, no code changes) ────────
# Driver: none (default) | memory | redis
# CACHE_DRIVER=none
# Redis settings (required when CACHE_DRIVER=redis):
# REDIS_ADDR=localhost:6379
# REDIS_PASSWORD=
# REDIS_DB=0
# Default TTL applied when a Set call omits one:
# CACHE_DEFAULT_TTL=5m
# Namespace prefix so multiple environments can share one Redis cluster:
# CACHE_KEY_PREFIX=mvtms:

# ── File Storage Backend ───────────────────────────────────────────────
# Driver: local (default) | s3 (s3 requires wiring an S3 client first)
# STORAGE_DRIVER=local
# LOCAL_STORAGE_DIR=./uploads

# ── Multi-Instance Safety ──────────────────────────────────────────────
# Elect a single leader via DB lease table so background workers (crons,
# relays, sweepers) run on exactly one replica. No-op on single instance.
# WORKER_LEADER_LOCK=true

# Server port
PORT=8080

# Cookie signing secret (use a strong random string; 32+ bytes recommended)
COOKIE_SECRET=change-me-to-a-random-32-byte-string

# API token signing secret. MUST be set to a strong random value distinct from
# COOKIE_SECRET in production (server refuses to start otherwise).
API_SECRET=

# Razorpay keys (required in production; no test-key fallback allowed)
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=

# Application environment: development, staging, production
APP_ENV=development

# Application Domain
APP_DOMAIN=avandab.com

# Log level: debug, info, warn, error
LOG_LEVEL=info

# Session cookie Secure attribute. Defaults to true in production, false in
# development (plain HTTP). Override explicitly if needed.
# COOKIE_SECURE=true

# Optional: create the initial admin account at startup (only when no admin
# exists yet and BOOTSTRAP_ADMIN_PASSWORD meets the 8-char minimum).
# No default admin is seeded anymore.
# BOOTSTRAP_ADMIN_EMAIL=admin@yourcompany.com
# BOOTSTRAP_ADMIN_NAME=Admin
# BOOTSTRAP_ADMIN_PASSWORD=

# Integration stubs (all disabled by default; set *_ENABLED=true to enable)
# INTEGRATION_EWAYBILL_ENDPOINT=https://ewaybill.nic.in/api
# INTEGRATION_EWAYBILL_API_KEY=
# INTEGRATION_EWAYBILL_ENABLED=false

# INTEGRATION_GSTN_ENDPOINT=https://api.gstn.org
# INTEGRATION_GSTN_API_KEY=
# INTEGRATION_GSTN_ENABLED=false

# INTEGRATION_FASTAG_ENDPOINT=https://api.fastag.org
# INTEGRATION_FASTAG_API_KEY=
# INTEGRATION_FASTAG_ENABLED=false

# INTEGRATION_ACCOUNTING_ENDPOINT=https://api.accounting.example.com
# INTEGRATION_ACCOUNTING_API_KEY=
# INTEGRATION_ACCOUNTING_ENABLED=false

# ── RAG (Codebase Search) ──────────────────────────────────────────────
# Enable RAG system for codebase/document search
# RAG_ENABLED=true
# Embedding API key (OpenAI-compatible; omit to use hash-based fallback)
# RAG_EMBEDDING_API_KEY=
# Embedding API base URL (default: https://api.openai.com/v1)
# RAG_EMBEDDING_BASE_URL=
# Embedding model (default: text-embedding-3-small)
# RAG_EMBEDDING_MODEL=text-embedding-3-small
# Chunk size in characters (default: 512)
# RAG_CHUNK_SIZE=512
# Chunk overlap in characters (default: 50)
# RAG_CHUNK_OVERLAP=50
# Comma-separated directories to index at startup
# RAG_INDEX_DIRS=internal,docs
# Path for the vector store SQLite database
# RAG_VECTOR_DB_PATH=./rag_vectors.db

# ── Teaching the RAG ───────────────────────────────────────────────────
# Upload documents (PDF, TXT, MD) for the RAG to learn from
# Max file size: 10MB
# Supported formats: .txt, .md, .pdf (text-based PDFs)

# Example: teach via API
# curl -X POST http://localhost:8080/api/rag/teach \
#   -H "Content-Type: application/json" \
#   -d '{"name": "company policies", "content": "All bookings..."}'

# ── AI Agent (Operations Assistant) ────────────────────────────────────
# Enable the AI operations assistant (/assistant chat page + /api/agent/chat)
# AGENT_ENABLED=true
# LLM API key (OpenAI-compatible chat completions API)
# AGENT_API_KEY=
# LLM API base URL (default: https://api.openai.com/v1)
# AGENT_BASE_URL=https://api.openai.com/v1
# LLM model (default: gpt-4o-mini)
# AGENT_MODEL=gpt-4o-mini
# Max reasoning turns per conversation (default: 10)
# AGENT_MAX_TURNS=10
# Enable the online RL loop (episode logging, rewards, few-shot learning) (default: true)
# AGENT_RL_ENABLED=true
# RL database path (episodes, actions, rewards, tool stats) (default: agent_rl.db)
# AGENT_RL_DB_PATH=agent_rl.db
# Require admin approval before the agent can mutate data (bookings, payments, assignments, kharcha) (default: true)
# AGENT_REQUIRE_APPROVAL=true

# ── Route Optimization (Wave A — Spec 18) ────────────────────────────────
# Provider: mock | osrm-public | osrm-selfhost | http://custom:5000
# ROUTING_PROVIDER=mock
# OSRM_URL=http://osrm.internal:5000
# For dev: ROUTING_PROVIDER=osrm-public (http://router.project-osrm.org, ~1 req/sec, no SLA)
# For prod: self-host OSRM (2-4 CPU, 8GB RAM, India OSM ~2GB) — see docs/ops/osrm-setup.md
# ── Multi-tenant mode ────────────────────────────────────────────
# false = every request resolves to bootstrap tenant '1' (single-org deploy).
# true  = per-user tenant resolution via users.tenant_id + tenants.status;
#         suspended orgs are rejected at the edge (web 303 w/ flash, API 401).
# MULTI_TENANT_ENABLED=false
